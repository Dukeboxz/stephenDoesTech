---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome</h1>
			<p>
				My name is Stephen and I do tech. I am a senior software developer who has worked in a range
				of industries but mainly in the communication industry. Working mostly in the .NET stack, I
				do dabble in other technologies as well, both professionally and on my own.
			</p>
			<p>This site is my blog on things in tech that interest me enough to write about.</p>
		</main>
		<Footer />
	</body>
</html>
